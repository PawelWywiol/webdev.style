---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import MediaController from '../components/MediaController.astro';
import Head from '../components/en/Head.astro';
import { Content as WelcomeContent } from '../content/en/welcome.md';
import { Content as InvitationContent } from '../content/en/invitation.md';
import { Content as AboutContent } from '../content/en/about.md';
import { Content as SkillsContent } from '../content/en/skills.md';
import { Content as ExperienceContent } from '../content/en/experience.md';
import { Content as Portfolio } from '../content/en/portfolio.md';
import { Content as Interests } from '../content/en/interests.md';
import { Content as Contact } from '../content/en/contact.md';
---

<Layout>
  <Head slot="head" />
  <MediaController />
  <Section>
    <WelcomeContent />
  </Section>
  <Section>
    <InvitationContent />
  </Section>
  <Section>
    <AboutContent />
  </Section>
  <Section>
    <SkillsContent />
  </Section>
  <Section>
    <ExperienceContent />
  </Section>
  <Section>
    <Portfolio />
  </Section>
  <Section>
    <Interests />
  </Section>
  <Section>
    <Contact />
  </Section>
</Layout>
